{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "mvn -B versions:set -DnewVersion=${nextRelease.version} -DgenerateBackupPoms=false && mvn -B -DskipTests clean package"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "target/keycloak-email-otp-authenticator-v*.jar",
            "label": "Keycloak Email OTP Authenticator JAR"
          }
        ]
      }
    ]
  ]
}
